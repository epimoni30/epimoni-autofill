{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "description": "__MSG_ext_description__",
  "version": "0.1.0",
  "default_locale": "fr",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.epimoni30.com/*",
    "https://fpd66hmugz4o7j6g7t4obpxlca0bgrvk.lambda-url.eu-central-1.on.aws/*"
  ],
  "externally_connectable": {
    "matches": ["https://www.epimoni30.com/*"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_action_title__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "matches": [
        "https://candidat.francetravail.fr/*",
        "https://*.hellowork.com/*",
        "https://*.apec.fr/*",
        "https://*.welcometothejungle.com/*",
        "https://*.indeed.fr/*",
        "https://fr.indeed.com/*"
      ]
    },
    {
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "matches": ["https://www.linkedin.com/jobs/*"]
    }
  ],
  "homepage_url": "https://www.epimoni30.com/extension-chrome"
}
